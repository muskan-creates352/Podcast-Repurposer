# Server Configuration
PROJECT_NAME="AI Podcast Repurposer API"
API_PREFIX="/api"
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (Allows frontend React/Next.js dev server)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration
# Default to PostgreSQL, or fallback to SQLite for immediate local zero-setup execution
DATABASE_URL=sqlite:///./podcast.db
# Uncomment below for PostgreSQL in production or local docker:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/podcast_db

# JWT Authentication
SECRET_KEY=college_viva_super_secret_jwt_key_2026_secure_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Upload Directory (relative or absolute)
UPLOAD_DIR=uploads

# Gemini API Key (Required for Phase 2 GenAI pipeline)
GEMINI_API_KEY=your_gemini_api_key_here
